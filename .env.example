# ==============================================================================
# TreeMap Monorepo Environment Configuration (.env.example)
# Copy this file to .env or .env.local and populate with your local values.
# No secret keys or production passwords should be committed!
# ==============================================================================

# Supabase Local or Cloud Settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (Direct PostGIS / Postgres)
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:54322/postgres
INGEST_DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:54322/postgres

# MapLibre & Vector Tiles (Open source, no Google Maps, no Mapbox)
# Default base map style from OpenFreeMap (open vector tiles, no key required)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# PMTiles URL for Tree Layer (Self-hosted or CDN)
# Point this at the public URL of the trees.pmtiles file after pnpm tiles:build.
# The Map component automatically prepends the pmtiles:// protocol prefix.
NEXT_PUBLIC_TREE_TILES_URL=https://your-bucket.s3.amazonaws.com/trees.pmtiles

# Object Storage — used by scripts/tiles/build-tiles.sh and the nightly CI job
# S3-compatible endpoint (leave blank for AWS S3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=treemap-tiles
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Pilot City Coordinates & Defaults (e.g. Berlin or Frankfurt or Regensburg)
DEFAULT_CITY_NAME=Berlin
DEFAULT_MAP_LAT=52.5200
DEFAULT_MAP_LON=13.4050
DEFAULT_MAP_ZOOM=13
NEXT_PUBLIC_CITY_NAME=Berlin
NEXT_PUBLIC_MAP_LAT=52.5200
NEXT_PUBLIC_MAP_LON=13.4050
NEXT_PUBLIC_MAP_ZOOM=13

# Third-party Integrations (Edge Functions)
PLANTNET_API_KEY=
